FROM ros:humble-ros-base-jammy
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions python3-pytest python3-numpy python3-scipy \
    python3-yaml python3-opencv python3-pil \
    ros-humble-moveit-msgs ros-humble-control-msgs ros-humble-controller-manager-msgs \
    ros-humble-cv-bridge ros-humble-tf2-ros ros-humble-ur-moveit-config \
    ros-humble-robot-state-publisher && rm -rf /var/lib/apt/lists/*
ENV ROS_LOCALHOST_ONLY=1 ROS_DOMAIN_ID=231
WORKDIR /workspace
CMD ["bash", "scripts/test_humble.sh"]
